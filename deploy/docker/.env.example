# Copy to .env (git-ignored) and fill in. Never commit .env.

# Domain that serves the instance. Every ActivityPub id is under https://{MY_HOST}/, so it must not change later.
MY_HOST=localhost:8080

# Origin that browsers open the instance at. Keep http://{MY_HOST} to sign in from a browser on this machine over
# plain HTTP (MY_HOST and MY_HTTP_PORT must then name the same port). Behind a TLS-terminating reverse proxy, remove
# it or set https://{MY_HOST}.
MY_WEB_ORIGIN=http://localhost:8080

# Key-encryption key for actor private keys. Generate it with `openssl rand -base64 32` and back it up apart from
# the database (docs/operations/key-management.md). The server receives it as a Docker secret file.
MY_KEK=

# Port on 127.0.0.1 that the server is published on.
MY_HTTP_PORT=8080

# Version stamped into the images and used as their tag.
MY_VERSION=dev
