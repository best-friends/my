{
  "name": "@my/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p scripts/tsconfig.json",
    "check-tokens": "bun run scripts/check-tokens.ts src/storybook.css ../web/src/index.css",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "dependencies": {
    "react-aria-components": "1.21.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
