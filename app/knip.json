{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["oxlint/*.test.js"],
      "project": ["oxlint/**/*.js"],
      "tailwind": false
    },
    "ui": {
      "entry": ["src/**/*.stories.tsx", "src/storybook.css"],
      "project": ["src/**/*.{ts,tsx,css}", "test/**/*.ts", "scripts/**/*.ts", ".storybook/**/*.{ts,tsx}", "*.config.ts"]
    },
    "web": {
      "entry": ["e2e/server.ts", "sw/**/*.test.ts", "vite-plugins/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "sw/**/*.ts", "vite-plugins/**/*.ts", "e2e/**/*.ts", "*.config.ts"],
      "ignore": ["src/lib/api/schema.gen.ts"],
      "ignoreDependencies": ["openapi-typescript"]
    }
  }
}
